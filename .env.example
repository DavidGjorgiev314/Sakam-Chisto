# Copy this file to .env and fill in your own values.
#   cp .env.example .env
#
# .env is git-ignored, so your real credentials never reach the repository.

# Your Docker Hub account. Used to name the images built by docker-compose
# and to reference images in the k8s/ manifests. Use the same value you set
# as the DOCKERHUB_USERNAME secret in GitHub.
DOCKERHUB_USERNAME=your-dockerhub-username

# PostgreSQL database, user and password shared by the database and backend.
POSTGRES_DB=sakamchisto
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# HS256 signing key for the JWT tokens issued by the backend.
# REQUIRED - the backend will not start without it, and it must be at least
# 32 characters long. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# Host port the frontend container is published on. Open http://localhost:<APP_PORT>.
APP_PORT=8080

# Comma-separated list of browser origins allowed to call the API directly.
# Not needed when the app is served through the frontend nginx proxy.
CORS_ALLOWED_ORIGINS=http://localhost:8080
